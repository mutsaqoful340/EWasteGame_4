  m_Name: 
  m_EditorClassIdentifier: 
  vnDialogManager: {fileID: 884966005}
  vnDialogAkhir:
  - namaKarakter: Saka
    dialog: Kadang, orang mikir kalo satu baterai, satu kabel, satu kardus... ah,
      kecil. Gak penting.
  - namaKarakter: Saka
    dialog: Tapi kamu udah lihat sendiri dari yang kecil-kecil itu, bisa jadi tumpukan
      besar. Bisa mencemari air, tanah, bahkan ngeracunin manusia.
  - namaKarakter: Saka
    dialog: "Kamu ngerti bahwa daur ulang bukan soal sampah\u2026 tapi soal kesempatan
      kedua. Untuk barang. Untuk bumi. Bahkan untuk kita sendiri."
  - namaKarakter: Saka
    dialog: "Dan yang kayak kamu\u2026 adalah bagian dari solusi."
  - namaKarakter: Saka
    dialog: Sampai jumpa di tantangan berikutnya. Dunia ini butuh lebih banyak orang
      sepertimu.
