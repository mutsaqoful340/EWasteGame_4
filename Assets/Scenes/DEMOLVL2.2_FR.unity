  vnDialogManager: {fileID: 800574212}
  vnDialogAkhir:
  - namaKarakter: Saka
    dialog: Kerja bagus, Sobat Ewaste
  - namaKarakter: Saka
    dialog: Setiap komponen yang kamu pilih tadi punya dampak besar.
  - namaKarakter: Saka
    dialog: Yang kamu jual, bisa dimanfaatkan ulang. Yang kamu daur ulang, bisa mengurangi
      limbah berbahaya.
  - namaKarakter: Saka
    dialog: Kalau semua orang sepeduli ini, bumi kita bisa jauh lebih bersih.
  - namaKarakter: Saka
    dialog: Kamu sekarang nggak cuma paham soal sampah, tapi juga tentang nilai tersembunyi
      dari barang elektronik bekas.
  - namaKarakter: Saka
    dialog: Hebat. Hari ini kamu sudah selangkah lebih dekat jadi ahli daur ulang
      sejati.
  - namaKarakter: Saka
    dialog: Besok, kita akan menghadapi tantangan yang lebih rumit.
