  namaText: {fileID: 707590995}
  dialogText: {fileID: 1575867229}
  btnLanjut: {fileID: 1794642358}
  dialogList:
  - namaKarakter: Saka
    dialog: Selamat pagi! Kamu datang tepat waktu.
  - namaKarakter: Saka
    dialog: Hari ini tugasmu masih sama yaitu memilah sampah elektronik dan nonorganik.
  - namaKarakter: Saka
    dialog: Tapi... kali ini jumlahnya jauh lebih banyak. Dan jenis-jenisnya juga
      makin beragam.
  - namaKarakter: Saka
    dialog: Fokus, dan pastikan kamu tidak tertukar saat memasukkan ke kotaknya.
  - namaKarakter: Saka
    dialog: Kalau kamu bisa menyelesaikan hari ini tanpa kesalahan, kamu akan naik
      ke tantangan berikutnya.
  - namaKarakter: Saka
    dialog: Siap? Ayo mulai!
