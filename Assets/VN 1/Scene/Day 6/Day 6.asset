  m_Script: {fileID: 11500000, guid: 38b9ceca75ea97d458c11e0633bbd393, type: 3}
  m_Name: Day 6
  m_EditorClassIdentifier: 
  sentences:
  - text: Ujang, kamu kerja sendiri dulu ya.
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Aku ada urusan keluar kota beberapa hari.
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Oh, oke bang.
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: Ga masalah kan ditinggal nanti?
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Aman, bang. Udah mulai hafal kok harus gimana.
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: Oke, jangan lupa makan, Jang
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  background: {fileID: 0}
  nextScene: {fileID: 0}
