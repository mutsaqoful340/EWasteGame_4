  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38b9ceca75ea97d458c11e0633bbd393, type: 3}
  m_Name: D1_Int.Kantor S
  m_EditorClassIdentifier: 
  sentences:
  - text: Hehe, emang mejanya berantakan, tapi sering dibersihin kok ini!
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Gini, Jang.
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Kamu bisa ikut kerja disini, jadi pengepul limbah elektronik terus dijual
      ke tempat daur ulang.
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Hah??
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: Maksudnya?
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: Iya, Pengepul.
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Nanti ada alat elektronik bekas yang nanti kamu bongkar dan kumpulin yang
      nanti bisa dijual.
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Upahmu nanti bergantung pada stok yang sudah kamu kumpulkan per harinya,
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Itu semua nanti bakal dikirim ke tempat daur ulang
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Gimana, mau ikut kerja nggak?
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Boleh deh, daripada ga kerja sama sekali.
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: Prosesnya gimana tuh kira-kira?
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: Bagini, Jang.
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  background: {fileID: 21300000, guid: 111cb5ab318aeb840b0c2a591cc31251, type: 3}
  nextScene: {fileID: 0}
