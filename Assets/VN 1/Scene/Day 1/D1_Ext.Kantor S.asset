  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38b9ceca75ea97d458c11e0633bbd393, type: 3}
  m_Name: D1_Ext.Kantor S
  m_EditorClassIdentifier: 
  sentences:
  - text: Kerja apa aja deh, yang penting bisa buat makan sama nabung buat pulang.
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: Asli, tahun ini lagi gila-gilaan PHK massal.
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Oh, Bang Sakha, aku dapat kerja apa?
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: Simple kok, cuma bongkar sampah elektronik dan memilah.
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Oh, limbah elektronik ya?
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: Iya. Soal upah tergantung jumlah stok yang kamu bongkar dan seberapa cepat
      selesai. Setiap hari limbah bakal dikirim ke daur ulang.
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Prosesnya kayak gimana?
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: 'Karena kita pengepul pertama, prosesnya begini:'
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  background: {fileID: 21300000, guid: 4537654e66f991c4589bf62b91f88a47, type: 3}
  nextScene: {fileID: 11400000, guid: 1b19a3064c2e90f4e9a4edb07c86df86, type: 2}
