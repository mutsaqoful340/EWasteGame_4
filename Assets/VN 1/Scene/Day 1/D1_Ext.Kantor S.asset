  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38b9ceca75ea97d458c11e0633bbd393, type: 3}
  m_Name: D1_Ext.Kantor S
  m_EditorClassIdentifier: 
  sentences:
  - text: "(Ujang terlihat bingug melihat tempat yang disebut \u201Ckantor\u201D
      oleh Sakha, karena lebih terlihat seperti gudang rumah yang dimodifikasi)"
    speaker: {fileID: 11400000, guid: cb95e0dfcf6ebbb44b50cee3e89d00cc, type: 2}
  - text: '*Bang Sakha lagi ga bohong kan ini? ini mah gada bedanya sama kantor-kantor
      fiktif kemarin.*'
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: 'Malah sekarang emang musimnya susah kerja, Jang.. '
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Jadi emang harus pinter pinteran bertahan hidup.
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: "Kalau nggak bikin usaha sendiri ya\u2026lontang lantung"
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: Yok masuk, kantornya bersih kok walau berantakan sedikit
    speaker: {fileID: 11400000, guid: bb619b1bdc32f27479d1fc9c8e310caf, type: 2}
  - text: (Sakha mengajak ujang yang terlihat ragu-ragu namun memilih ikut masuk)
    speaker: {fileID: 11400000, guid: cb95e0dfcf6ebbb44b50cee3e89d00cc, type: 2}
  background: {fileID: 21300000, guid: 111cb5ab318aeb840b0c2a591cc31251, type: 3}
  nextScene: {fileID: 11400000, guid: 1b19a3064c2e90f4e9a4edb07c86df86, type: 2}
