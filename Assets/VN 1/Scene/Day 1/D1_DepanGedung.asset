  m_Script: {fileID: 11500000, guid: 38b9ceca75ea97d458c11e0633bbd393, type: 3}
  m_Name: D1_DepanGedung
  m_EditorClassIdentifier: 
  sentences:
  - text: ' '
    speaker: {fileID: 11400000, guid: cb95e0dfcf6ebbb44b50cee3e89d00cc, type: 2}
  - text: "Nasib\u2026nasib,"
    speaker: {fileID: 11400000, guid: cb95e0dfcf6ebbb44b50cee3e89d00cc, type: 2}
  - text: Niatnya ngerantau buat bantu orang tua eh malah jadi gembel gini.
    speaker: {fileID: 11400000, guid: cb95e0dfcf6ebbb44b50cee3e89d00cc, type: 2}
  - text: Mau pulang juga gimana,
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: "Kesini aja pake duit bapak\u2026"
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: Mati aku kalo pulang sekarang.
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: (Ujang Buka Dompet)
    speaker: {fileID: 11400000, guid: cb95e0dfcf6ebbb44b50cee3e89d00cc, type: 2}
  - text: Makan dulu kali ya.
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  - text: Lumayan lah, bisa beli nasi telur.
    speaker: {fileID: 11400000, guid: 7ac3d55cf39c704458e1bfb061f38222, type: 2}
  background: {fileID: 21300000, guid: 74789920801d9ce4b85456071c9f0219, type: 3}
  nextScene: {fileID: 11400000, guid: a96f9419c0fa1cb47a3a8eb11ff2a821, type: 2}
